    <main>

        
        <button class="btn-reserva" onclick="abrirFormulario()">
            Reserve seu horário
        </button>

        
        <div id="form-agendamento" style="display: none; margin-top: 20px;">
            <h2>Agende seu horário</h2>

            <form>
                <label>Nome:</label><br>
