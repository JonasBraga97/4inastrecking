* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: #000;
    color: #fff;
}


header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    background-color: #000;
    position: relative;
}

header nav {
    order: 1; 
    padding: 20px 40px;
    font-size: 1.2rem;
}

header nav a {
    color: #005500; 
    text-decoration: none;
    padding: 0 10px;
    transition: 0.3s;
}

header nav a:hover {
    color: #00ff00;
}


header > p:not(.texto), .slogan {
    order: 2; 
    color: #00cc00;
    font-size: 1.5rem;
    padding-right: 40px;
}

header img {
    order: 4; 
    width: 100%;
    height: auto;
    object-fit: cover;
    max-height: 600px;
    display: block;
}

header p.texto {
    order: 3;
    position: absolute;
    top: 55%;
    left: 8%;
    transform: translateY(-50%);
    font-size: 7vw;
    font-weight: 800;
    color: #00cc00;
    z-index: 10;
}


footer {
    background-color: #14a014;
    color: #ffffff;
    padding: 20px 40px 40px 40px;
    display: flex;
    flex-direction: column;
    gap: 15px;
}

footer p.copyright, footer .copyright {
    font-size: 1.3rem;
    font-weight: bold;
}

footer .endereco {
    font-size: 1rem;
}


main section:nth-of-type(1):not(.banner-produtos):not(.banner)
 {
    display: grid;
    grid-template-columns: 1fr 1fr; 
    grid-template-rows: auto auto 1fr;
    background-color: #ffffff;
}

main section:nth-of-type(1):not(.banner-produtos):not(.banner) img {
    grid-column: 1;
    grid-row: 1 / 4;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

main section:nth-of-type(1):not(.banner-produtos):not(.banner) h1 {
    grid-column: 2;
    grid-row: 1;
    color: #2ab91d;
    font-size: 6rem;
    padding: 60px 0 10px 60px;
}

main section:nth-of-type(1):not(.banner-produtos):not(.banner) p.texto {
    grid-column: 2;
    grid-row: 2;
    font-size: 1.3rem;
    font-weight: bold;
    color: #000;
    padding-left: 60px;
    margin-bottom: 25px;
}

main section:nth-of-type(1):not(.banner-produtos):not(.banner) p:not(.texto) {
    grid-column: 2;
    grid-row: 3;
    font-size: 1.1rem;
    color: #333;
    line-height: 1.5;
    padding: 0 60px;
}

main section:nth-of-type(2):not(.frase-destaque):not(.contato-info)
 {
    background-color: #14a014; 
    color: #ffffff;
    padding: 30px 40px 0 40px; 
}

main section:nth-of-type(2):not(.frase-destaque):not(.contato-info) p.texto
 {
    font-size: 1.3rem;
    font-weight: bold;
}

.btn-reserva {
    position: absolute;
    bottom: 30%; 
    left: 5%; 
    background-color: #d4f7f6; 
    color: #000000;
    padding: 15px 80px; 
    border-radius: 40px; 
    text-decoration: none; 
    font-weight: bold;
    font-size: 1.1rem;
    box-shadow: 2px 4px 10px rgba(0, 0, 0, 0.5); 
    transition: background-color 0.3s; 
}

.btn-reserva:hover { background-color: #b0e6e4; }


.banner-produtos {
    background-image: url('images/Fundo-2.webp'); 
    background-size: cover; 
    background-position: center; 
    background-repeat: no-repeat;
    height: 700px; 
    width: 100%;
    display: flex;
    align-items: flex-start; 
    justify-content: flex-start; 
    padding: 100px 40px; 
}

.banner-produtos h1 {
    color: #ffffff; 
    font-size: 8rem; 
    font-weight: bold;
}

.frase-destaque { color: #ffffff; padding: 0; }

.frase_efeito_1 {
    padding: 20px 40px;
    color: #ffffff;
    font-size: 3rem;
    font-weight: bold;
    line-height: 1.2;
    background-color: #000;
}

.galeria {
    display: grid;
    grid-template-columns: 1fr 1fr; 
    max-width: 800px; 
    margin: 50px 40px 80px auto;
}

.item-galeria { position: relative; }
.item-galeria.destaque { grid-column: span 2; }
.item-galeria img { width: 100%; height: 100%; object-fit: cover; display: block; }

.texto-imagem {
    position: absolute;
    top: 20px;
    left: 20px;
    color: #00cc00; 
    font-size: 3rem; 
    line-height: 1; 
}

.banner { position: relative; width: 100%; }
.banner img { width: 100%; height: auto; display: block; }

.banner h1 {
    position: absolute;
    top: 20%; 
    left: 5%; 
    color: #ffffff; 
    font-size: 6rem;
}

.contato-info {
    background-color: #000;
    padding: 40px 40px;
    display: flex;
    flex-direction: column;
    gap: 25px; 
}

.contato-info p {
    font-size: 1.8rem; 
    color: #fff; 
}

.contato-info a {
    color: #fff;
    text-decoration: underline; 
}
